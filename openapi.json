  "components": {
    "securitySchemes": {
      "ApiKeyAuth": {
        "type": "apiKey",
        "in": "header",
        "name": "Authorization",
        "description": "Bearer token authentication"
      }
    },
    "schemas": {
      "AnalyzeRequest": {
        "type": "object",
        "required": ["text"],
        "properties": {
          "text": {
            "type": "string",
            "description": "Text to analyze"
          },
          "type": {
            "type": "string",
            "enum": ["general", "sentiment", "keywords"],
            "default": "general",
            "description": "Analysis type"
          }
        }
      },
      "AnalyzeResponse": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean"
          },
          "type": {
            "type": "string"
          },
          "analysis": {
            "type": "object",
            "properties": {
              "wordCount": {
                "type": "number"
              },
              "characterCount": {
                "type": "number"
              },
              "characterCountNoSpaces": {
                "type": "number"
              },
              "sentenceCount": {
                "type": "number"
              },
              "paragraphCount": {
                "type": "number"
              },
              "averageWordLength": {
                "type": "number"
              },
              "readingTime": {
                "type": "number"
              },
              "sentiment": {
                "type": "string"
              },
              "positiveCount": {
                "type": "number"
              },
              "negativeCount": {
                "type": "number"
              },
              "confidence": {
                "type": "number"
              },
              "keywords": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "word": {
                      "type": "string"
                    },
                    "count": {
                      "type": "number"
                    }
                  }
                }
              }
            }
          }
        }
      },
      "GenerateRequest": {
        "type": "object",
        "required": ["prompt"],
        "properties": {
          "prompt": {
            "type": "string",
            "description": "Input text/prompt"
          },
          "type": {
            "type": "string",
            "enum": ["summary", "title", "hashtags"],
            "default": "summary",
            "description": "Generation type"
          },
          "length": {
            "type": "string",
            "enum": ["short", "medium", "long"],
            "default": "medium",
            "description": "Output length"
          }
        }
      },
      "GenerateResponse": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean"
          },
          "type": {
            "type": "string"
          },
          "result": {
            "type": "string",
            "description": "Generated content"
          }
        }
      },
      "TransformRequest": {
        "type": "object",
        "required": ["data", "operation"],
        "properties": {
          "data": {
            "type": "string",
            "description": "Data to transform"
          },
          "operation": {
            "type": "string",
            "enum": ["uppercase", "lowercase", "reverse", "base64_encode", "base64_decode", "json_prettify", "json_minify"],
            "description": "Transformation operation"
          }
        }
      },
      "TransformResponse": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean"
          },
          "operation": {
            "type": "string"
          },
          "result": {
            "type": "string",
            "description": "Transformed data"
          }
        }
      },
      "ValidateRequest": {
        "type": "object",
        "required": ["data", "type"],
        "properties": {
          "data": {
            "type": "string",
            "description": "Data to validate"
          },
          "type": {
            "type": "string",
            "enum": ["email", "url", "phone", "json"],
            "description": "Validation type"
          }
        }
      },
      "ValidateResponse": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean"
          },
          "type": {
            "type": "string"
          },
          "validation": {
            "type": "object",
            "properties": {
              "valid": {
                "type": "boolean"
              },
              "errors": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        }
      },
      "ExtractRequest": {
        "type": "object",
        "required": ["text", "type"],
        "properties": {
          "text": {
            "type": "string",
            "description": "Text to extract from"
          },
          "type": {
            "type": "string",
            "enum": ["emails", "urls", "phone_numbers", "hashtags", "mentions"],
            "description": "Extraction type"
          }
        }
      },
      "ExtractResponse": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean"
          },
          "type": {
            "type": "string"
          },
          "extracted": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Extracted items"
          },
          "count": {
            "type": "number",
            "description": "Number of items extracted"
          }
        }
      },
      "CompareRequest": {
        "type": "object",
        "required": ["data1", "data2"],
        "properties": {
          "data1": {
            "type": "string",
            "description": "First data"
          },
          "data2": {
            "type": "string",
            "description": "Second data"
          },
          "type": {
            "type": "string",
            "enum": ["text", "json"],
            "default": "text",
            "description": "Comparison type"
          }
        }
      },
      "CompareResponse": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean"
          },
          "type": {
            "type": "string"
          },
          "comparison": {
            "type": "object",
            "properties": {
              "similarity": {
                "type": "number"
              },
              "commonWords": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "difference": {
                "type": "object",
                "properties": {
                  "inText1": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "inText2": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                }
              },
              "equal": {
                "type": "boolean"
              },
              "keys1": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "keys2": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "addedKeys": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "removedKeys": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "error": {
                "type": "string"
              }
            }
          }
        }
      },
      "HealthResponse": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string"
          },
          "version": {
            "type": "string"
          },
          "timestamp": {
            "type": "string"
          },
          "uptime": {
            "type": "number"
          }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean"
          },
          "error": {
            "type": "string"
          }
        }
      }
    }
  },
