{
  "name": "@aether/prompt-optimizer",
  "version": "1.0.0",
  "description": "Prompt engineering optimization library with A/B testing, metrics tracking, and template system",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage"
  },
  "keywords": [
    "prompt",
    "optimization",
    "a-b-testing",
    "prompt-engineering",
    "llm",
    "ai",
    "machine-learning"
  ],
  "author": "Aether",
  "license": "MIT",
  "dependencies": {
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "typescript": "^5.3.0",
    "vitest": "^4.1.8",
    "@vitest/ui": "^1.0.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    }
  }
}
