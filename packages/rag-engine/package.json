{
  "name": "@aether/rag-engine",
  "version": "1.0.0",
  "description": "Retrieval Augmented Generation engine with vector database abstraction, document chunking, and citation tracking",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage"
  },
  "keywords": [
    "rag",
    "retrieval",
    "augmented",
    "generation",
    "vector",
    "embedding",
    "search",
    "ai",
    "machine-learning"
  ],
  "author": "Aether",
  "license": "MIT",
  "dependencies": {
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "typescript": "^5.3.0",
    "vitest": "^4.1.8",
    "@vitest/ui": "^1.0.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    }
  }
}
