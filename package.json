{
  "name": "aether",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@10.0.0",
  "scripts": {
    "dev": "pnpm --filter \"./apps/**\" --parallel dev",
    "dev:backend": "pnpm --filter @aether/backend dev",
    "dev:frontend": "pnpm --filter @aether/frontend dev",
    "dev:bridge": "pnpm --filter @aether/bridge dev",
    "build": "pnpm --filter @aether/backend build && pnpm --filter @aether/frontend build && pnpm --filter @aether/mcp-server build",
    "build:mcp": "pnpm --filter @aether/mcp-server build",
    "start": "pnpm --filter @aether/backend start",
    "start:mcp": "pnpm --filter @aether/mcp-server start",
    "setup:gemini": "node scripts/setup-gemini.js"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "puppeteer": "^25.1.0"
  }
}
