{
  "name": "aether",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev --parallel",
    "dev:backend": "npm run dev -w @aether/backend",
    "dev:frontend": "npm run dev -w @aether/frontend",
    "dev:bridge": "npm run dev -w @aether/bridge",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "start": "npm run start -w @aether/backend",
    "clean": "turbo run clean",
    "iac:drift-check": "node scripts/iac-drift-check.mjs",
    "metrics:verify": "node scripts/strategy-metrics-verify.mjs"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "esbuild": "^0.28.0",
    "execa": "^9.6.1",
    "turbo": "^2.9.14",
    "vite": "^8.0.16",
    "vitest": "^4.1.8"
  },
  "packageManager": "pnpm@9.15.0"
}
