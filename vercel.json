{
  "version": 2,
  "buildCommand": "npm run build -w @aether/backend",
  "builds": [
    {
      "src": "apps/backend/dist/server.cjs",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/apps/backend/dist/server.cjs"
    },
    {
      "src": "/(.*)",
      "dest": "/apps/backend/dist/server.cjs"
    }
  ]
}