{
  "version": "1.0.0",
  "name": "aether-monorepo",
  "workers": [
    {
      "name": "aether-verifier",
      "path": "apps/aether-verifier",
      "has_d1": true
    },
    {
      "name": "aether-bridge",
      "path": "apps/bridge",
      "has_d1": true,
      "has_kv": true,
      "has_r2": true,
      "service_bindings": ["aether"]
    },
    {
      "name": "homebase",
      "path": "apps/homebase"
    },
    {
      "name": "notion-worker",
      "path": "apps/notion-worker",
      "has_d1": true
    },
    {
      "name": "weekly-digest",
      "path": "apps/weekly-digest"
    }
  ],
  "external_workers": [
    {
      "name": "aether",
      "note": "External dispatcher worker not in this monorepo"
    }
  ]
}
