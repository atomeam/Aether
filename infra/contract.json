{
  "version": "1.0.0",
  "name": "aether-monorepo",
  "workers": [
    {
      "name": "aether-verifier",
      "path": "apps/aether-verifier",
      "wranglerToml": "apps/aether-verifier/wrangler.toml",
      "d1": { "migrationsPath": "apps/aether-verifier/migrations" }
    },
    {
      "name": "aether-bridge",
      "path": "apps/bridge",
      "wranglerToml": "apps/bridge/wrangler.toml",
      "d1": { "migrationsPath": "apps/bridge/migrations" },
      "kv": true,
      "r2": true,
      "serviceBindings": [
        { "binding": "DISPATCHER", "worker": "aether" },
        { "binding": "AETHER", "worker": "aether" }
      ]
    },
    {
      "name": "homebase",
      "path": "apps/homebase",
      "wranglerToml": "apps/homebase/wrangler.toml"
    },
    {
      "name": "notion-worker",
      "path": "apps/notion-worker",
      "wranglerToml": "apps/notion-worker/wrangler.toml",
      "d1": { "migrationsPath": "apps/notion-worker/migrations" }
    },
    {
      "name": "weekly-digest",
      "path": "apps/weekly-digest",
      "wranglerToml": "apps/weekly-digest/wrangler.toml"
    }
  ],
  "external_workers": [
    {
      "name": "aether",
      "note": "External dispatcher worker not in this monorepo"
    }
  ]
}
