# Aether Sovereign Engine Configuration
# Copy to .env and fill in your values

# ===========================================
# AI SERVICE INTEGRATIONS
# ===========================================

# OpenAI - GPT models, DALL-E, Whisper
# Get your key from https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Anthropic - Claude AI models
# Get your key from https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Google AI - Gemini models
# Get your key from https://makersuite.google.com/app/apikey
GOOGLE_AI_API_KEY=

# Cohere - Text generation and embedding
# Get your key from https://dashboard.cohere.ai/api-keys
COHERE_API_KEY=

# HuggingFace - Open-source models
# Get your key from https://huggingface.co/settings/tokens
HUGGINGFACE_API_KEY=

# Replicate - Open-source model hosting
# Get your token from https://replicate.com/account/api-tokens
REPLICATE_API_TOKEN=

# ===========================================
# BUSINESS INTEGRATIONS
# ===========================================

# Stripe - Payment Processing
# Get your keys from https://dashboard.stripe.com/apikeys
STRIPE_API_KEY=

# HubSpot - CRM
# Get your key from https://app.hubspot.com/settings/api-key
HUBSPOT_API_KEY=

# ===========================================
# COMMUNICATION INTEGRATIONS
# ===========================================

# Slack - Team Communication
# Create a bot at https://api.slack.com/apps
SLACK_BOT_TOKEN=

# ===========================================
# MONITORING INTEGRATIONS
# ===========================================

# Sentry - Error Monitoring (optional)
# Get from https://sentry.io/settings/<org>/api-keys
SENTRY_AUTH_TOKEN=

# ===========================================
# LEGACY / OTHER
# ===========================================
GEMINI_API_KEY=

# ===========================================
# VICTUS RUNTIME CONFIGURATION
# ===========================================
NEURAL_BRIDGE_URL=http://localhost:8080
VICTUS_RUNTIME_URL=http://localhost:8080

# MCP Servers
MCP_SERVER_URL=http://localhost:3100
AI_ORCHESTRATOR_MCP_URL=http://localhost:3101
